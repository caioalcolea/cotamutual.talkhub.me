# ---------------------------------------------------------------------------
# cotamutual — Bot de cotacoes por grupo + painel de controle
# Copie para .env e preencha. NUNCA versione o .env.
# ---------------------------------------------------------------------------

PORT=3000

# --- Mutual API v2 ---
MUTUAL_PROD_BASE_URL=https://apis.mutual.app.br
MUTUAL_HML_BASE_URL=https://apis-hml.mutual.app.br
# Ambiente usado para /crypto/quote: "prod" (validado — cotacao e somente
# leitura; ordens seguem bloqueadas por ORDERS_ENABLED) ou "hml"
MUTUAL_CRYPTO_ENV=prod
MUTUAL_API_KEY=ak_SUA_CHAVE_AQUI
MUTUAL_SERVICE_TOKEN=SEU_SERVICE_TOKEN

# --- Fase atual: ordens SEMPRE desabilitadas ---
# Enquanto false, o sistema NUNCA chama POST /api/v2/crypto/orders.
ORDERS_ENABLED=false

# --- Fila de cotacoes ---
# Toda cotacao envia esta quantidade de mensagens, cada uma com requisicao
# propria a Mutual (precos variam a cada segundo). Interrompivel por /COMPRAR.
QUOTE_QUEUE_MESSAGES=10
QUOTE_QUEUE_INTERVAL_MS=3000
# Valor BRL de referencia usado apenas para descobrir o preco unitario
# quando o usuario informa quantidade do ativo (ex: /REF 25K USDT).
QUOTE_REFERENCE_BRL_AMOUNT=1000
# Se o ambiente configurado responder no formato "quote" (preco de provider
# com spread), buscar o TICKER (preco de mercado sem fee) na URL alternativa.
QUOTE_TICKER_FALLBACK=true

# --- Cache (merchants/fees). Cotacao NUNCA usa cache. ---
MERCHANT_CACHE_TTL_MS=60000
FEE_CACHE_TTL_MS=60000

# --- Persistencia local (toggles do painel + registro de cotacoes) ---
DATA_DIR=./data

# --- Webhook de entrada (mensagens dos grupos) ---
# Se definido, POST /webhook exige Authorization: Bearer <token> (ou ?token=).
WEBHOOK_TOKEN=

# --- Envio de mensagens de volta ao grupo ---
# "evolution": Evolution API v2 (producao) — POST {base}/message/sendText/{instance}
# "webhook":   POST generico em OUTBOUND_WEBHOOK_URL com {channel, groupId, text}
# "log":       apenas registra (desenvolvimento)
OUTBOUND_MODE=evolution
OUTBOUND_WEBHOOK_URL=
OUTBOUND_TOKEN=

# --- Evolution API v2 (OUTBOUND_MODE=evolution) ---
EVOLUTION_BASE_URL=https://whatsapp.talkhub.me
EVOLUTION_INSTANCE=talkbia
EVOLUTION_API_KEY=5f7b34ec-3302-4c46-9c90-76c374ca9862

# --- Painel de controle ---
# Se definido, /api/panel exige Authorization: Bearer <token> (ou ?token=).
PANEL_TOKEN=
