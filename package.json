{
  "name": "cotamutual",
  "version": "2.0.0",
  "description": "Bot de cotacoes por grupo (Mutual API v2) com fila de cotacoes, fees por merchant e painel de controle",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
